# Copy to .env on the Pi:
#   cp example.env .env
#
# These are host-side compose values. Login passwords, HA tokens, and the
# session-signing key live in the SQLite DB (the sweepy-data volume), not here.

# In-container path to the DB. The file itself is on the named volume.
DATABASE_URL=file:/app/data/sweepy.db

# Host port published as http://<pi>:3000 (Cloudflare tunnel points here).
SWEEPY_PORT=3000
