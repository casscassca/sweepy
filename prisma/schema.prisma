generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Room {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("🏠")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Task {
  id            String   @id @default(cuid())
  name          String
  roomId        String
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  difficulty    Int      @default(1)
  frequencyDays Int      @default(7)
  allowedDays   String?
  lastDoneAt    DateTime?
  createdAt     DateTime @default(now())
  assignableUsers TaskAssignableUser[]
  assignments     DailyAssignment[]
  completions     CompletionLog[]
}

model TaskAssignableUser {
  taskId String
  userId String
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model User {
  id             String   @id @default(cuid())
  name           String
  haNotifyTarget String   @default("")
  dailyCapacity  Int      @default(6)
  notifyTime     String   @default("08:00")
  color          String   @default("#6366f1")
  createdAt      DateTime @default(now())
  assignableTasks TaskAssignableUser[]
  assignments     DailyAssignment[]
  completions     CompletionLog[]
  completedFor    CompletionLog[]      @relation("CompletedFor")
}

model DailyAssignment {
  id            String    @id @default(cuid())
  date          String
  userId        String
  taskId        String
  order         Int       @default(0)
  completedAt   DateTime?
  completedById String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([date, taskId])
  @@index([date])
}

model CompletionLog {
  id            String   @id @default(cuid())
  taskId        String
  userId        String
  completedById String
  completedAt   DateTime @default(now())
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedBy   User     @relation("CompletedFor", fields: [completedById], references: [id], onDelete: Cascade)
}

model Settings {
  id        String @id @default("singleton")
  haUrl     String @default("")
  haToken   String @default("")
  darkMode  Boolean @default(false)
}
